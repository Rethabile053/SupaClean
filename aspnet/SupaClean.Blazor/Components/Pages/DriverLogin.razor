@page "/driver-login"
@* @rendermode InteractiveServer *@
@layout Layout.EmptyLayout

@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using SupaClean.Application.Interfaces
@using SupaClean.Application.DTOs
@using SupaClean.Domain.Enums

@inject IStaffAuthService Auth
@inject NavigationManager Nav

<PageTitle>Driver Log In</PageTitle>

<div class="login-screen">
    <aside class="login-brand-panel">
        <div>
            <div class="login-logo">Supa<span>Clean</span></div>
            <div class="login-tagline">
                DRY CLEANING OPS · BETTER
            </div>
        </div>

        <div class="login-pitch">
            <h2>Manage your operations, all in one place.</h2>
            <p>
                Sign in to manage customers, orders, services,
                drivers and payments across your SupaClean operations.
            </p>
            <ul>
                <li>Manage order information</li>
                <li>Track driver activities</li>
                <li>Review addresses</li>
            </ul>
        </div>

        <div class="login-access">DRIVER ACCESS</div>
    </aside>

    <main class="login-form-panel">
        <div class="login-logo login-mobile-logo">
            Supa<span>Clean</span>
        </div>

        <div class="login-form">
            <div class="login-role-label">DRIVER PORTAL</div>

            <h1>Driver Log In</h1>

            <p class="login-subtitle">
                Enter your Driver credentials to continue.
            </p>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="login-error" role="alert">
                    @error
                </div>
            }

            <EditForm Model="Input" OnValidSubmit="LoginAsync" FormName="driver-login" method="post">
                <DataAnnotationsValidator />

                <div class="login-field">
                    <label for="driver-email">Email address</label>
                    <InputText id="driver-email"
                               type="email"
                               autocomplete="username"
                               placeholder="you@supaclean.com"
                               @bind-Value="Input.Email" />
                    <ValidationMessage For="@(() => Input.Email)" />
                </div>

                <div class="login-field">
                    <label for="driver-password">Password</label>
                    <InputText id="driver-password"
                               type="password"
                               autocomplete="current-password"
                               placeholder="Enter your password"
                               @bind-Value="Input.Password" />
                    <ValidationMessage For="@(() => Input.Password)" />
                </div>

                <button type="submit" class="login-button">Log In as Driver</button>
            </EditForm>

            <div class="login-switch">
                <span>Are you an Admin?</span>
                <a href="/admin-login">Log in as Admin</a>
            </div>

            <p class="login-help">
                Need assistance?
                <a href="mailto:support@supaclean.com">
                    Contact support
                </a>
            </p>
        </div>

        <footer class="login-footer">
            Support · Help · Privacy
        </footer>
    </main>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginModel Input { get; set; } = new();

    private string? error;

    private async Task LoginAsync()
    {
        error = null;
        bool signedIn = false;

        try
        {
            // FIX: this page is for drivers, so ask for the Driver role
            StaffLoginResult result = await Auth.SignInAsync(
                Input.Email.Trim(),
                Input.Password,
                Role.Driver);

            if (!result.Success || result.Profile is null)
            {
                error = result.Error ?? "Unable to sign in with these credentials.";
                return;
            }

            if (HttpContext is null)
            {
                error = "The login session could not be created.";
                return;
            }

            var identity = new ClaimsIdentity(new[]
            {
                new Claim(ClaimTypes.NameIdentifier, result.Profile.UserId.ToString()),
                new Claim(ClaimTypes.Name, result.Profile.FullName),
                new Claim(ClaimTypes.Email, Input.Email.Trim()),
                new Claim(ClaimTypes.Role, result.Profile.Role.ToString())
            }, "Cookies");

            await HttpContext.SignInAsync("Cookies", new ClaimsPrincipal(identity));
            signedIn = true;
        }
        catch (Exception ex)
        {
            // Shows the real error in the Visual Studio Output window
            Console.WriteLine(ex);
            error = "Unable to sign in right now. Please try again.";
        }

        // Must be OUTSIDE the try/catch, or the catch will block the redirect
        if (signedIn)
        {
            // FIX: send drivers to the driver page, not the admin page
            // Change this to your real driver page route if it's different
            Nav.NavigateTo("/driver/deliveries", forceLoad: true);
        }
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your email address.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}