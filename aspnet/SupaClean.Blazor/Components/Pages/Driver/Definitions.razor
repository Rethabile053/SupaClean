@page "/driver/status-definitions"
@* @attribute [Authorize(Roles = "Driver,Admin")] *@
@using Microsoft.AspNetCore.Authorization

<PageTitle>Status definitions</PageTitle>

<div class="definitions-page">
    <header class="definitions-header">
        <h1>Status definitions</h1>
        <p>What each status and payment label means on your route</p>
    </header>

    <section class="definitions-grid">
        <div class="definition-card">
            <span class="pill pill--neutral">Pending</span>
            <p>Stop scheduled but not started yet.</p>
        </div>

        <div class="definition-card">
            <span class="pill pill--blue">Out for delivery</span>
            <p>Order is on your vehicle on its way to the customer.</p>
        </div>

        <div class="definition-card">
            <span class="pill pill--yellow">Working</span>
            <p>You are at the stop or handling the collection or delivery.</p>
        </div>

        <div class="definition-card">
            <span class="pill pill--red">Exception</span>
            <p>Delivery or collection failed. Add a note, e.g. customer unavailable.</p>
        </div>

        <div class="definition-card">
            <span class="pill pill--green">Completed</span>
            <p>Collection or delivery confirmed, with photo if required.</p>
        </div>

        <div class="definition-card">
            <span class="pill pill--neutral">Account</span>
            <p>Customer is billed on account. No payment at the door.</p>
        </div>

        <div class="definition-card">
            <span class="pill pill--red">Alert</span>
            <p>Something needs attention, e.g. a delay or access problem.</p>
        </div>

        <div class="definition-card">
            <span class="pill pill--yellow">Cash on delivery</span>
            <p>Collect payment at the doorstep and confirm it in the app.</p>
        </div>
    </section>
</div>