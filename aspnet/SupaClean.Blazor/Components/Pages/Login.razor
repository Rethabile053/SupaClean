@page "/login"
@rendermode InteractiveServer
@layout Layout.EmptyLayout
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using SupaClean.Service
@inject IStaffAuthService Auth
@inject NavigationManager Nav

<PageTitle>Sign in</PageTitle>

<div class="screen">
    <aside class="brand-panel">
        <div>
            <div class="logo">Supa<span>Clean</span></div>
            <div class="tagline">DRY CLEANING OPS · BETTER</div>
        </div>

        <div class="pitch">
            <h2>Streamline your dry cleaning operations.</h2>
            <p>Sign in to access your employee dashboard, manage orders, and stay on top of your daily queue.</p>
            <ul>
                <li>Real-time order queue management</li>
                <li>Customer &amp; driver coordination</li>
                <li>Instant exception alerts</li>
            </ul>
        </div>

        <div class="employee-access">EMPLOYEE ACCESS</div>
    </aside>

    <main class="form-panel">
        <div class="logo mobile-logo">Supa<span>Clean</span></div>

        <EditForm Model="Input" FormName="login" method="post" OnValidSubmit="LoginAsync" class="form">
            <DataAnnotationsValidator />

            <h1>Sign in</h1>
            <p class="subtitle">Enter your credentials to continue</p>

            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }

            <div class="field">
                <label for="email">Email address</label>
                <InputText id="email" type="email" autocomplete="username"
                           placeholder="you@supaclean.com" @bind-Value="Input.Email" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="field">
                <div class="label-row">
                    <label for="password">Password</label>
                    <a class="link" href="mailto:support@supaclean.com?subject=Password%20reset">Forgot password?</a>
                </div>
                <InputText id="password" type="password" autocomplete="current-password"
                           placeholder="············" @bind-Value="Input.Password" />
                <ValidationMessage For="() => Input.Password" />
            </div>

            <button type="submit" name="intent" value="staff" class="btn primary">Sign in</button>

            <div class="divider"><span>or</span></div>

            <button type="submit" name="intent" value="admin" class="btn secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="11" width="16" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                Sign in as Admin
            </button>

            <p class="help">
                Need access?
                <a class="link" href="mailto:support@supaclean.com?subject=Staff%20access%20request">Contact your administrator</a>
            </p>
        </EditForm>

        <footer class="page-footer">Support · Help · Privacy</footer>
    </main>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm] private LoginModel Input { get; set; } = new();

    // Which button was pressed: "staff" (Sign in) or "admin" (Sign in as Admin)
    [SupplyParameterFromForm(Name = "intent")] private string? Intent { get; set; }

    private string? error;

    protected override void OnInitialized() => Input ??= new();

    private async Task LoginAsync()
    {
        StaffUserDto? user;
        try
        {
            user = await Auth.SignInAsync(Input.Email, Input.Password);
        }
        catch (Exception)
        {
            error = "Couldn't sign in right now. Try again in a moment.";
            return;
        }

        if (user is null)
        {
            // user get the same messagw weather the password or email is incorrect
            error = "Incorrect email or password.";
            return;
        }

        if (Intent == "admin" && user.Role != "Admin")
        {
            error = "This account doesn't have admin access. Use Sign in instead.";
            return;
        }

        var identity = new ClaimsIdentity(new[]
        {
            new Claim(ClaimTypes.NameIdentifier, user.Id),
            new Claim(ClaimTypes.Name, user.FullName),
            new Claim(ClaimTypes.Role, user.Role)
        }, "Cookies");

        await HttpContext.SignInAsync("Cookies", new ClaimsPrincipal(identity));

        Nav.NavigateTo(user.Role == "Admin" ? "orders" : "driver", forceLoad: true);
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}
