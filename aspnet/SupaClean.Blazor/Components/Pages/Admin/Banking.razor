@page "/admin/banking"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Banking details</PageTitle>

<div class="admin-shell">

    <aside class="side-menu">
        <div class="brand">SupaClean</div>

        <nav class="side-nav">
            <NavLink href="/admin/deliveries" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" />
                    <circle cx="7" cy="18" r="1.6" />
                    <circle cx="17" cy="18" r="1.6" />
                </svg>
                <span>Deliveries</span>
            </NavLink>

            <NavLink href="/admin/banking-details" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 10l9-5 9 5M5 10v8M10 10v8M14 10v8M19 10v8M3 20h18" />
                </svg>
                <span>Banking details</span>
            </NavLink>

            <NavLink href="/driver/status-definitions" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 11v5M12 8h.01" />
                </svg>
                <span>Status definitions</span>
            </NavLink>
        </nav>
    </aside>

    <main class="banking-page">

        <section class="details-card">
            <h2>Business details</h2>

            <div class="field-grid field-grid--two">
                <div class="field">
                    <span class="field-label">Business name</span>
                    <div class="field-value">SupaClean Laundry and Dry Clean</div>
                </div>

                <div class="field">
                    <span class="field-label">Support phone</span>
                    <div class="field-value">051 430 4241</div>
                </div>

                <div class="field">
                    <span class="field-label">Support email</span>
                    <div class="field-value">info@supaclean.com</div>
                </div>

                <div class="field">
                    <span class="field-label">Service area</span>
                    <div class="field-value">Bloemfontein, Free State</div>
                </div>
            </div>
        </section>

        <section class="details-card">
            <h2>Banking details (EFT)</h2>

            <div class="field-grid field-grid--three">
                <div class="field">
                    <span class="field-label">Bank</span>
                    <div class="field-value">Standard Bank</div>
                </div>

                <div class="field">
                    <span class="field-label">Branch code</span>
                    <div class="field-value">051001</div>
                </div>

                <div class="field">
                    <span class="field-label">Account number</span>
                    <div class="field-value">189100558</div>
                </div>
            </div>
        </section>

    </main>
</div>