@page "/admin/payments"
@layout Layout.EmptyLayout
@using SupaClean.Application.DTOs
@using SupaClean.Application.Services
@using SupaClean.Domain.Enums
@attribute [Authorize(Roles = "Admin")]
@inject IPaymentService PaymentService
@inject IOrderService OrderService
@inject NavigationManager Navigation

<PageTitle>Payments</PageTitle>

<div class="payments-shell">
    <aside class="services-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">S</div>
            <div>
                <h3>SupaClean</h3>
                <span>Management Portal</span>
            </div>
        </div>

        <nav class="sidebar-menu">
            <a class="sidebar-link" href="/admin/customers">
                <span></span> Customers
            </a>
            <a class="sidebar-link" href="/admin/orders">
                <span></span> Orders
            </a>
            <a class="sidebar-link" href="/admin/payments">
                <span></span> Payments
            </a>
            <a class="sidebar-link" href="/admin/serviceCatalog">
                <span></span> Service Catalog
            </a>
            <a class="sidebar-link active" href="/admin/assignDriver">
                <span></span> Assign Driver
            </a>
            <a class="sidebar-link" href="/admin/notifications">
                <span></span> Notifications
            </a>
        </nav>

        <div class="sidebar-profile">
            <div class="profile-avatar">KM</div>
            <div>
                <strong></strong>
                <span>Administrator</span>
            </div>
        </div>
    </aside>

    <main class="payments-workspace">
        <header class="payments-topbar">
            <div>
                <h1>Payments Management</h1>
                <p>Review payments and verify proof of payment.</p>
            </div>
        </header>

        <section class="payments-content">
            <div class="payments-toolbar">
                <input class="payment-search"
                       placeholder="Search by customer or order ID..."
                       @bind="SearchText"
                       @bind:event="oninput" />

                <button class="refresh-button"
                        @onclick="LoadPaymentsAsync">
                    Refresh
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="message-error">@ErrorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="message-success">@SuccessMessage</div>
            }

            @if (IsLoading)
            {
                <p class="loading-message">Loading payments...</p>
            }
            else
            {
                <div class="payments-table-wrapper">
                    <table class="payments-table">
                        <thead>
                            <tr>
                                <th>Customer ID</th>
                                <th>Payment Status</th>
                                <th>Type of Payment</th>
                                <th>Payment Method</th>
                                <th>Verification Status</th>
                                <th>Proof of Payment</th>
                                <th>Rejection Reason</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (FilteredPayments.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="empty-message">
                                        No payments found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var payment in FilteredPayments)
                                {
                                    <tr @key="payment.PaymentId">
                                        <td>
                                            <span class="customer-id">
                                                @payment.CustomerId
                                            </span>
                                        </td>

                                        <td>
                                            <select class="payment-select"
                                                    @bind="payment.PaymentStatus">
                                                @foreach (var status in Enum.GetNames<PaymentStatus>())
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            <select class="payment-select"
                                                    @bind="payment.PaymentType">
                                                @foreach (var type in Enum.GetNames<PaymentType>())
                                                {
                                                    <option value="@type">@FormatName(type)</option>
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            <select class="payment-select"
                                                    @bind="payment.PaymentMethod">
                                                @foreach (var method in Enum.GetNames<PaymentMethod>())
                                                {
                                                    <option value="@method">@FormatName(method)</option>
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            <select class="payment-select"
                                                    @bind="payment.VerificationStatus">
                                                @foreach (var status in Enum.GetNames<VerificationStatus>())
                                                {
                                                    <option value="@status">@status</option>
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(payment.ProofOfPayment))
                                            {
                                                <button class="pdf-link"
                                                        @onclick="() => OpenProofAsync(payment)">
                                                    View PDF
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="no-proof">No PDF uploaded</span>
                                            }
                                        </td>

                                        <td>
                                            <textarea class="rejection-input"
                                                      @bind="payment.RejectionReason"
                                                      placeholder="Enter reason..."
                                                      rows="2"></textarea>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="payments-footer">
                    <span>@FilteredPayments.Count payment(s) displayed</span>

                    <button class="save-button"
                            disabled="@IsSaving"
                            @onclick="SaveChangesAsync">
                        @(IsSaving ? "Saving..." : "Save Changes")
                        @* changes are saved *@
                    </button>
                </div>
            }
        </section>
    </main>
</div>

@code {
    private List<EditablePayment> Payments = new();

    private string SearchText = string.Empty;
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsLoading;
    private bool IsSaving;

    private List<EditablePayment> FilteredPayments =>
        Payments.Where(p =>
            string.IsNullOrWhiteSpace(SearchText) ||
            p.CustomerId.ToString().Contains(SearchText,
                StringComparison.OrdinalIgnoreCase) ||
            p.OrderId.ToString().Contains(SearchText,
                StringComparison.OrdinalIgnoreCase)
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadPaymentsAsync();
    }

    private async Task LoadPaymentsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            // This method must return all payments, not only unverified ones.
            var records = await PaymentService.GetAllPaymentsAsync();
            var loaded = new List<EditablePayment>();

            foreach (var p in records)
            {
                var order = await OrderService.GetOrderByIdAsync(p.OrderId);

                loaded.Add(new EditablePayment
                {
                    PaymentId = p.PaymentId,
                    OrderId = p.OrderId,
                    CustomerId = order?.CustomerId,
                    PaymentStatus = p.PaymentStatus,
                    PaymentType = p.PaymentType,
                    PaymentMethod = p.PaymentMethod,
                    VerificationStatus = p.VerificationStatus,
                    ProofOfPayment = p.ProofOfPayment,
                    RejectionReason = p.RejectionReason
                });
            }

            Payments = loaded;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Could not load payments: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task OpenProofAsync(EditablePayment payment)
    {
        ErrorMessage = null;

        try
        {
            // Must return a public URL or a newly generated signed URL for the proof payment pdf.
            var url = await PaymentService.GetProofOfPaymentUrlAsync(
                payment.PaymentId);

            if (string.IsNullOrWhiteSpace(url))
            {
                ErrorMessage = "The PDF could not be found.";
                return;
            }

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Could not open proof of payment: {ex.Message}";
        }
    }

    private async Task SaveChangesAsync()
    {
        IsSaving = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            foreach (var p in FilteredPayments)
            {
                await PaymentService.UpdateAdminPaymentAsync(
                    p.PaymentId,
                    p.PaymentStatus,
                    p.PaymentType,
                    p.PaymentMethod,
                    p.VerificationStatus,
                    p.RejectionReason);
            }

            SuccessMessage = "Payment changes saved successfully.";
            await LoadPaymentsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Could not save payment changes: {ex.Message}";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string FormatName(string value) =>
        string.Concat(value.Select((c, i) =>
            i > 0 && char.IsUpper(c) ? " " + c : c.ToString()));

    private sealed class EditablePayment
    {
        public Guid PaymentId { get; set; }
        public Guid OrderId { get; set; }
        public Guid? CustomerId { get; set; }
        public string PaymentStatus { get; set; } = "Due";
        public string PaymentType { get; set; } = "Orderpayment";
        public string PaymentMethod { get; set; } = "EFT";
        public string VerificationStatus { get; set; } = "Pending";
        public string? ProofOfPayment { get; set; }
        public string? RejectionReason { get; set; }
    }
}