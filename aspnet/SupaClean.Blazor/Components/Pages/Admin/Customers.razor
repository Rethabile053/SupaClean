@page "/"
@page "/admin/customers"
@layout Layout.EmptyLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using SupaClean.Application.DTOs.CustomerDto
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager Navigation
@inject ICustomerService CustomerService


<PageTitle>Customers</PageTitle>

<div class="customers-shell">

    <!-- Sidebar -->
    <aside class="services-sidebar">
        <div class="sidebar-brand">
            <div class="sidebar-logo">S</div>
            <div>
                <h2>SupaClean</h2>
            </div>
        </div>

        <div class="sidebar-section-title">MENU</div>

        <nav class="sidebar-nav">
            <a href="/admin/customers" class="sidebar-link">
                <span class="nav-icon">▤</span>
                <span>Customers</span>
            </a>

            <a href="/admin/orders" class="sidebar-link active">
                <span class="nav-icon">♙</span>
                <span>orders</span>
            </a>

            <a href="/admin/services" class="sidebar-link">
                <span class="nav-icon">♧</span>
                <span>Services</span>
            </a>

            <a href="/admin/drivers" class="sidebar-link">
                <span class="nav-icon">♧</span>
                <span>Drivers</span>
            </a>

            <a href="/admin/notifications" class="sidebar-link">
                <span class="nav-icon">♢</span>
                <span>Notifications</span>
            </a>
        </nav>

        <div class="sidebar-profile">
            <div class="profile-avatar">K</div>
            <div class="profile-info">
                <strong>Kayla Matthews</strong>
                <span>Administrator</span>
            </div>
        </div>
    </aside>

    <!-- Main content -->
    <main class="customers-workspace">

        <header class="customers-topbar">
            <div>
                <span class="breadcrumb">SupaClean / Customers</span>
                <h2>Customers</h2>
            </div>
        </header>

        <section class="customers-content">

            <div class="customer-table-card">

                <div class="customer-table-heading">
                    <h1>Customers</h1>

                    <button type="button"
                            class="add-customer-button"
                            @onclick="GoToAddCustomer">
                        <span>+</span> Add customer
                    </button>
                </div>

                @if (IsLoading)
                {
                    <div class="customer-message">
                        Loading customers...
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="customer-message error-message">
                        @ErrorMessage

                        <button class="retry-button"
                                @onclick="LoadCustomersAsync">
                            Retry
                        </button>
                    </div>
                }
                else if (Customers.Count == 0)
                {
                    <div class="customer-message">
                        No customers found.
                    </div>
                }
                else
                {
                    <div class="customer-table-wrapper">
                        <table class="customer-table">
                            <thead>
                                <tr>
                                    <th>Customer name</th>
                                    <th>Phone number</th>
                                    <th>City</th>
                                    <th>Address</th>
                                    <th>Email</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var customer in Customers)
                                {
                                    <tr @key="customer.CustomerId">
                                        <td class="customer-name">
                                            @customer.FirstName
                                        </td>

                                        <td>
                                            @customer.PhoneNumber
                                        </td>

                                        <td>
                                            @customer.City
                                        </td>

                                        <td class="customer-address">
                                            @customer.Address
                                        </td>

                                        <td>
                                            @customer.Email
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>

        </section>
    </main>
</div>

@code {
    private List<CustomerDto> Customers = new();  //check the CustomerDto in the DTOs

    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var result = await CustomerService.GetAllAsync();
            Customers = result.ToList();
        }
        catch (Exception)
        {
            ErrorMessage =
                "Unable to load customers. Please check your connection and try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void GoToAddCustomer()
    {
        Navigation.NavigateTo("/admin/customers/add");
    }
}