 @page "/admin/orders"
@layout Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using SupaClean.Application.DTOs
@using SupaClean.Application.Interfaces
@using SupaClean.Domain.Enums

@attribute [Authorize(Roles = "Admin")]

@inject IOrderService OrderService
@inject NavigationManager Navigation

<PageTitle>Order Management | SupaClean</PageTitle>

<div class="orders-shell">

    <aside class="services-sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">S</div>
            <div>
                <h2>SupaClean</h2>
                <span>Management Portal</span>
            </div>
        </div>

        <nav class="sidebar-menu">
            <a href="/admin/orders" class="sidebar-link active">
                <span>▣</span> Orders
            </a>
            <a href="/admin/customers" class="sidebar-link">
                <span>♙</span> Customers
            </a>
            <a href="/admin/services" class="sidebar-link">
                <span>◇</span> Services
            </a>
            <a href="/admin/drivers" class="sidebar-link">
                <span>♧</span> Drivers
            </a>
            <a href="/admin/notifications" class="sidebar-link">
                <span>♢</span> Notifications
            </a>
        </nav>

        <div class="sidebar-profile">
            <div class="profile-avatar">KM</div>
            <div>
                <strong>will update the admin's name later'</strong>
                <span>Administrator</span>
            </div>
        </div>
    </aside>

    <main class="orders-workspace">

        <header class="orders-topbar">
            <div>
                <h1>Order Management</h1>
                <p>View and manage customer orders.</p>
            </div>

            
        </header>

        <section class="orders-content">

            <div class="orders-toolbar">
                <div class="order-filters">
                    <button type="button"
                            class="filter-button active">
                        All orders
                        <span>@Orders.Count</span>
                    </button>
                </div>

                <input class="order-search"
                       type="search"
                       placeholder="Search orders..."
                       @bind="SearchText"
                       @bind:event="oninput" />
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="message-error">
                    @ErrorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="message-success">
                    @SuccessMessage
                </div>
            }

            @if (IsLoading)
            {
                <div class="loading-message">
                    Loading orders...
                </div>
            }
            else if (FilteredOrders.Count == 0)
            {
                <div class="empty-message">
                    <h3>No orders found</h3>
                    <p>
                        @if (Orders.Count == 0)
                        {
                            @:There are currently no orders to display.
                        }
                        else
                        {
                            @:No orders match your search.
                        }
                    </p>
                </div>
            }
            else
            {
                <div class="orders-table-wrapper">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer ID</th>
                                <th>Service</th>
                                <th>Order status</th>
                                <th>Fulfillment</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var order in FilteredOrders)
                            {
                                <tr @key="order.OrderId">

                                    <td>
                                        <strong>
                                            @(string.IsNullOrWhiteSpace(order.OrderNumber)
                                                ? order.OrderId.ToString()[..8]
                                                : order.OrderNumber)
                                        </strong>

                                        <span class="order-subtext">
                                            @order.OrderId
                                        </span>
                                    </td>

                                    <td>
                                        <span class="customer-id">
                                            @order.CustomerId
                                        </span>
                                    </td>

                                    <td>
                                        @if (order.Items is not null &&
                                             order.Items.Any())
                                        {
                                            <div class="service-name">
                                                @(string.IsNullOrWhiteSpace(
                                                    order.Items.First().Description)
                                                    ? "Service"
                                                    : order.Items.First().Description)
                                            </div>

                                            @if (order.Items.Count > 1)
                                            {
                                                <span class="order-subtext">
                                                    +@(order.Items.Count - 1) more item(s)
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="order-subtext">
                                                No items
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <select class="status-select"
                                                value="@order.OrderStatus"
                                                disabled="@IsUpdating(order.OrderId)"
                                                aria-label="@($"Status for order {order.OrderNumber}")"
                                                @onchange="(e) => ChangeStatus(
                                                    order.OrderId,
                                                    e.Value?.ToString())">

                                            @foreach (var status in Enum.GetValues<OrderStatus>())
                                            {
                                                <option value="@status.ToString()">
                                                    @FormatStatus(status)
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <span class="fulfillment-label">
                                            Not available
                                        </span>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="orders-footer">
                Showing @FilteredOrders.Count of @Orders.Count orders
            </div>

        </section>
    </main>
</div>

@code {
    private List<OrderDto> Orders = new();

    private string SearchText = string.Empty;
    private string? ErrorMessage;
    private string? SuccessMessage;

    private bool IsLoading = true;

    private readonly HashSet<Guid> UpdatingOrderIds = new();

    private List<OrderDto> FilteredOrders =>
        Orders.Where(order =>
            Contains(order.OrderNumber, SearchText) ||
            Contains(order.OrderId.ToString(), SearchText) ||
            Contains(order.CustomerId.ToString(), SearchText) ||
            Contains(order.TicketNumber, SearchText) ||
            (order.Items != null &&
             order.Items.Any(item =>
                 Contains(item.Description, SearchText) ||
                 Contains(item.ServiceId.ToString(), SearchText))))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    private async Task LoadOrdersAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var result = await OrderService.GetAllOrdersAsync();
            Orders = result.ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load orders: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ChangeStatus(
        Guid orderId,
        string? selectedValue)
    {
        if (!Enum.TryParse<OrderStatus>(
                selectedValue,
                true,
                out var newStatus))
        {
            ErrorMessage = "Please select a valid order status.";
            return;
        }

        if (!UpdatingOrderIds.Add(orderId))
            return;

        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            await OrderService.UpdateOrderStatusAsync(
                orderId,
                newStatus);

            var result = await OrderService.GetAllOrdersAsync();
            Orders = result.ToList();

            SuccessMessage = "Order status updated successfully.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to update order status: {ex.Message}";

            // Reload to restore the status shown by the service.
            try
            {
                var result = await OrderService.GetAllOrdersAsync();
                Orders = result.ToList();
            }
            catch
            {
                // Keep the original error message.
            }
        }
        finally
        {
            UpdatingOrderIds.Remove(orderId);
        }
    }

    private bool IsUpdating(Guid orderId) =>
        UpdatingOrderIds.Contains(orderId);

    private void CreateOrder()
    {
        Navigation.NavigateTo("/admin/orders/create");
    }

    private static bool Contains(string? value, string search) =>
        string.IsNullOrWhiteSpace(search) ||
        (!string.IsNullOrWhiteSpace(value) &&
         value.Contains(
             search,
             StringComparison.OrdinalIgnoreCase));

    private static string FormatStatus(OrderStatus status)
    {
        return string.Concat(
            status.ToString().Select((character, index) =>
                index > 0 && char.IsUpper(character)
                    ? " " + character
                    : character.ToString()));
    }
}