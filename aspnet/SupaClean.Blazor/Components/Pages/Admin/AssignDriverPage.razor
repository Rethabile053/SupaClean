@layout Layout.EmptyLayout
@* Without a render mode the page is plain HTML: it shows data but its buttons
   cannot react to clicks. FreshScope() gives each action a new database connection. *@
@rendermode InteractiveServer
@inherits ScopedPageBase
@page "/admin/assign-driver"
@* @attribute [Authorize(Roles = "Admin")] *@
@using SupaClean.Application.DTOs
@using SupaClean.Application.Interfaces
@using SupaClean.Domain.Exceptions

<PageTitle>Assign Driver</PageTitle>

<div class="admin-layout">
    <!-- Sidebar -->
    <PortalSidebar />

    <!-- Main content -->
    <main class="main-content">
        <div class="page-header">
            <div>
                <h1>Assign Driver</h1>
                <p>Choose which driver collects or delivers each order. A driver sees only the orders given to them.</p>
            </div>

            <button class="search-button" type="button" @onclick="LoadAsync" disabled="@(IsLoading || IsSaving)">
                ↻ Refresh
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="message @(IsError ? "message-error" : "message-ok")">@Message</div>
        }

        @* Everyone in the database who has the Driver role. Only these can be chosen below. *@
        <section class="drivers-panel">
            <div class="drivers-head">
                <h2>Drivers in the system (@Drivers.Count)</h2>
                <button type="button" class="search-button" @onclick="ToggleAddDriver" disabled="@IsAddingDriver">
                    @(ShowAddDriver ? "Close" : "+ Add driver")
                </button>
            </div>

            @if (NewDriverResult is not null)
            {
                @* Shown once: it cannot be looked up again, so the admin must pass it on now. *@
                <div class="new-driver-result">
                    <strong>@NewDriverResult.FullName was added as a driver.</strong>
                    <p>
                        Give them these details. They sign in at the <em>Driver Log In</em> page.
                        This password is shown only now and cannot be looked up again.
                    </p>
                    <div class="credentials">
                        <div><span>Email</span><code>@NewDriverResult.Email</code></div>
                        <div><span>Temporary password</span><code>@NewDriverResult.TemporaryPassword</code></div>
                    </div>
                    <button type="button" class="clear-button" @onclick="DismissNewDriver">I have passed it on</button>
                </div>
            }

            @if (ShowAddDriver)
            {
                <div class="add-driver-form">
                    <div class="form-row">
                        <label for="drv-first">First name</label>
                        <input id="drv-first" @bind="NewFirstName" @bind:event="oninput" maxlength="50" />
                    </div>
                    <div class="form-row">
                        <label for="drv-last">Last name</label>
                        <input id="drv-last" @bind="NewLastName" @bind:event="oninput" maxlength="50" />
                    </div>
                    <div class="form-row">
                        <label for="drv-email">Email (their login)</label>
                        <input id="drv-email" type="email" @bind="NewEmail" @bind:event="oninput" maxlength="120" />
                    </div>
                    <div class="form-row">
                        <label for="drv-phone">Phone (optional)</label>
                        <input id="drv-phone" @bind="NewPhone" @bind:event="oninput" maxlength="30" />
                    </div>
                    <div class="form-row">
                        <label for="drv-license">Licence number (optional)</label>
                        <input id="drv-license" @bind="NewLicense" @bind:event="oninput" maxlength="40" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(AddDriverError))
                    {
                        <div class="message message-error">@AddDriverError</div>
                    }

                    <div class="form-actions">
                        <button type="button" class="clear-button" @onclick="ToggleAddDriver" disabled="@IsAddingDriver">Cancel</button>
                        <button type="button" class="save-button" @onclick="AddDriverAsync" disabled="@IsAddingDriver">
                            @(IsAddingDriver ? "Adding..." : "Add driver")
                        </button>
                    </div>
                </div>
            }

            @if (IsLoading)
            {
                <p class="drivers-note">Loading drivers...</p>
            }
            else if (Drivers.Count == 0)
            {
                <p class="drivers-note">
                    There are no drivers yet. Press "+ Add driver" to create one.
                </p>
            }
            else
            {
                <div class="driver-cards">
                    @foreach (var driver in Drivers)
                    {
                        <div class="driver-card" @key="driver.UserId">
                            <strong>@driver.FullName</strong>
                            <span>@(string.IsNullOrWhiteSpace(driver.Email) ? "No email" : driver.Email)</span>
                            <span class="driver-jobs @(driver.OpenJobs > 0 ? "busy" : "")">
                                @(driver.OpenJobs == 0 ? "No open jobs" : driver.OpenJobs == 1 ? "1 open job" : $"{driver.OpenJobs} open jobs")
                            </span>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- Search -->
        <div class="search-container">
            <label for="ticketSearch">Search orders</label>
            <input id="ticketSearch"
                   type="text"
                   placeholder="Order number, ticket number, customer or address..."
                   @bind="SearchText"
                   @bind:event="oninput" />

            <button type="button"
                    class="search-button"
                    @onclick="SearchOrders">
                Search
            </button>

            <button type="button"
                    class="clear-button"
                    @onclick="ClearSearch">
                Clear
            </button>
        </div>

        <!-- Orders table -->
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Customer Name</th>
                        <th>Order</th>
                        <th>Ticket Number</th>
                        <th>Job</th>
                        <th>Address</th>
                        <th>Phone</th>
                        <th>Driver</th>
                    </tr>
                </thead>

                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="7" class="empty-message">Loading orders...</td>
                        </tr>
                    }
                    else if (FilteredOrders.Any())
                    {
                        @foreach (var order in FilteredOrders)
                        {
                            <tr @key="order.OrderId" class="@(order.IsChanged ? "row-changed" : "")">
                                <td>@order.CustomerName</td>
                                <td class="order-id">@order.OrderNumber</td>
                                <td>@(string.IsNullOrWhiteSpace(order.TicketNumber) ? "—" : order.TicketNumber)</td>
                                <td>@order.StopType</td>
                                <td>@order.Address</td>
                                <td>@(string.IsNullOrWhiteSpace(order.Phone) ? "—" : order.Phone)</td>
                                <td>
                                    <select class="driver-select"
                                            @bind="order.SelectedDriverId"
                                            disabled="@IsSaving">
                                        <option value="">Not assigned</option>
                                        @foreach (var driver in Drivers)
                                        {
                                            <option value="@driver.UserId">@driver.FullName</option>
                                        }
                                    </select>
                                    @if (!string.IsNullOrWhiteSpace(order.RowMessage))
                                    {
                                        <small class="@(order.RowIsError ? "row-error" : "row-ok")">@order.RowMessage</small>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-message">
                                @(Orders.Count == 0
                                    ? "No orders need a driver right now. An order appears here when it is ready for collection or out for delivery."
                                    : "No orders match your search.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Actions below the table -->
        <div class="bottom-actions">
            <a class="maps-link"
               href="@GoogleMapsUrl"
               target="_blank"
               rel="noopener noreferrer">
                Open addresses in Google Maps
            </a>

            <button class="save-button"
                    type="button"
                    @onclick="SaveAssignmentsAsync"
                    disabled="@(IsSaving || IsLoading || ChangedCount == 0)">
                @(IsSaving ? "Saving..." : ChangedCount == 0 ? "Save Assignments" : $"Save Assignments ({ChangedCount})")
            </button>
        </div>
    </main>
</div>

@code {
    private IDriverAssignmentService Assignments => Svc<IDriverAssignmentService>();
    private IDriverAdminService DriverAdmin => Svc<IDriverAdminService>();

    // Who is signed in. Adding a driver creates a login account, so it is for admins only.
    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    // ---- add a driver ----
    private bool ShowAddDriver;
    private bool IsAddingDriver;
    private string NewFirstName = string.Empty;
    private string NewLastName = string.Empty;
    private string NewEmail = string.Empty;
    private string NewPhone = string.Empty;
    private string NewLicense = string.Empty;
    private string? AddDriverError;
    private AddDriverResult? NewDriverResult;

    private void ToggleAddDriver()
    {
        ShowAddDriver = !ShowAddDriver;
        AddDriverError = null;
    }

    private void DismissNewDriver() => NewDriverResult = null;

    private async Task AddDriverAsync()
    {
        AddDriverError = null;

        var user = AuthState is null ? null : (await AuthState).User;
        if (user?.Identity?.IsAuthenticated != true || !user.IsInRole("Admin"))
        {
            AddDriverError = "Please log in as an admin first. Adding a driver creates a login account.";
            return;
        }

        IsAddingDriver = true;
        FreshScope();
        try
        {
            NewDriverResult = await DriverAdmin.AddDriverAsync(
                new AddDriverDto(NewFirstName, NewLastName, NewEmail, NewPhone, NewLicense));

            NewFirstName = NewLastName = NewEmail = NewPhone = NewLicense = string.Empty;
            ShowAddDriver = false;
            await LoadAsync();
            Say($"{NewDriverResult.FullName} was added as a driver and can now be given orders.", error: false);
        }
        catch (BusinessRuleException ex)
        {
            AddDriverError = ex.Message;
        }
        catch (Exception)
        {
            AddDriverError = "Could not add the driver. Please try again.";
        }
        finally
        {
            IsAddingDriver = false;
        }
    }

    private string SearchText = string.Empty;
    private string Message = string.Empty;
    private bool IsError;
    private bool IsLoading = true;
    private bool IsSaving;

    private List<StopRow> Orders = new();
    private List<DriverOptionDto> Drivers = new();

    private IEnumerable<StopRow> FilteredOrders =>
        string.IsNullOrWhiteSpace(SearchText)
            ? Orders
            : Orders.Where(o => Matches(o, SearchText.Trim()));

    private int ChangedCount => Orders.Count(o => o.IsChanged);

    private string GoogleMapsUrl =>
        "https://www.google.com/maps/search/?api=1&query=" +
        Uri.EscapeDataString(
            string.Join(" ", FilteredOrders.Select(o => o.Address)
                .Where(a => !string.IsNullOrWhiteSpace(a))));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        FreshScope();
        IsLoading = true;
        try
        {
            Drivers = (await Assignments.GetDriversAsync()).ToList();
            Orders = (await Assignments.GetStopsAsync()).Select(StopRow.From).ToList();
        }
        catch (Exception)
        {
            Say("Could not load the orders. Please try again.", error: true);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static bool Matches(StopRow o, string term) =>
        Has(o.OrderNumber, term) || Has(o.TicketNumber, term)
        || Has(o.CustomerName, term) || Has(o.Address, term);

    private static bool Has(string? value, string term) =>
        value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

    private void SearchOrders()
    {
        var n = FilteredOrders.Count();
        Say(n > 0 ? $"{n} matching order(s) found." : "No orders match your search.", error: n == 0);
    }

    private void ClearSearch()
    {
        SearchText = string.Empty;
        Message = string.Empty;
    }

    private void Say(string text, bool error)
    {
        Message = text;
        IsError = error;
    }

    private async Task SaveAssignmentsAsync()
    {
        var changed = Orders.Where(o => o.IsChanged).ToList();
        if (changed.Count == 0) return;

        IsSaving = true;
        Message = string.Empty;
        FreshScope();

        var saved = 0;
        var failed = 0;
        foreach (var order in changed)
        {
            order.RowMessage = null;
            order.RowIsError = false;
            try
            {
                if (order.SelectedDriverId is { } driverId)
                    await Assignments.AssignAsync(order.OrderId, driverId);
                else
                    await Assignments.UnassignAsync(order.OrderId);
                saved++;
            }
            catch (BusinessRuleException ex)
            {
                order.RowMessage = ex.Message;
                order.RowIsError = true;
                failed++;
            }
            catch (KeyNotFoundException)
            {
                order.RowMessage = "This order or driver no longer exists. Refresh the list.";
                order.RowIsError = true;
                failed++;
            }
            catch (Exception)
            {
                order.RowMessage = "Could not save. Please try again.";
                order.RowIsError = true;
                failed++;
            }
        }

        // Show what is really saved. Rows that failed keep their message.
        var messages = changed.Where(o => o.RowIsError).ToDictionary(o => o.OrderId, o => o.RowMessage);
        try
        {
            FreshScope();
            Orders = (await Assignments.GetStopsAsync()).Select(StopRow.From).ToList();
            foreach (var row in Orders)
                if (messages.TryGetValue(row.OrderId, out var m))
                {
                    row.RowMessage = m;
                    row.RowIsError = true;
                }
        }
        catch (Exception)
        {
            // Keep the list as it is; the counts below still tell what happened.
        }

        if (failed == 0)
            Say($"Saved: {saved} order(s) updated. Drivers see their orders when they open the driver page.", error: false);
        else
            Say($"{saved} saved, {failed} not saved. See the note under each order that failed.", error: true);

        IsSaving = false;
    }

    private sealed class StopRow
    {
        public Guid OrderId { get; init; }
        public string OrderNumber { get; init; } = string.Empty;
        public string? TicketNumber { get; init; }
        public string StopType { get; init; } = string.Empty;
        public string CustomerName { get; init; } = string.Empty;
        public string Address { get; init; } = string.Empty;
        public string Phone { get; init; } = string.Empty;

        // The driver saved now, and the one chosen in the list.
        public Guid? AssignedDriverId { get; init; }
        public Guid? SelectedDriverId { get; set; }

        public bool IsChanged => SelectedDriverId != AssignedDriverId;

        public string? RowMessage { get; set; }
        public bool RowIsError { get; set; }

        public static StopRow From(AssignableStopDto s) => new()
        {
            OrderId = s.OrderId,
            OrderNumber = s.OrderNumber,
            TicketNumber = s.TicketNumber,
            StopType = s.StopType,
            CustomerName = s.CustomerName,
            Address = string.Join(", ", new[] { s.Address, s.City }.Where(x => !string.IsNullOrWhiteSpace(x))),
            Phone = s.CustomerPhone ?? string.Empty,
            AssignedDriverId = s.AssignedDriverUserId,
            SelectedDriverId = s.AssignedDriverUserId,
        };
    }
}
