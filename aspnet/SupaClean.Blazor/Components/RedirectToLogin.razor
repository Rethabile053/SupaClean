@inject NavigationManager Navigation

@* Shown instead of a page the person is not allowed to open. Nobody signed in is sent to the
   log in page for that part of the site. Someone signed in with the wrong role is told so,
   rather than being bounced around. *@

@if (SignedIn)
{
    <main style="font-family:Arial,sans-serif;max-width:520px;margin:15vh auto;padding:0 20px;text-align:center">
        <h1 style="font-size:24px">You do not have access to this page</h1>
        <p style="color:#555;line-height:1.5">
            This page is for a different kind of account. Log out and sign in with the right one.
        </p>
        <form method="post" action="/auth/logout">
            <button type="submit"
                    style="padding:11px 22px;border:0;border-radius:8px;background:#c9252c;color:#fff;font-size:14px;font-weight:600;cursor:pointer">
                Log out
            </button>
        </form>
    </main>
}

@code {
    [Parameter] public bool SignedIn { get; set; }

    protected override void OnInitialized()
    {
        if (SignedIn) return;

        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var login = path.StartsWith("/driver", StringComparison.OrdinalIgnoreCase) ? "/driver-login" : "/admin-login";
        Navigation.NavigateTo(login, forceLoad: true);
    }
}
